{
  "appId": "com.ajing.aidj",
  "productName": "AJING - AI DJ Desktop",
  "asar": true,
  "directories": {
    "output": ".build"
  },
  "files": [
    "desktop/**/*",
    "src/**/*",
    "scripts/**/*",
    "node_modules/**/*",
    "package.json",
    ".env.example",
    "README.md",
    "!scripts/dev/**/*"
  ],
  "extraMetadata": {
    "main": "desktop/main.js"
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "category": "public.app-category.music",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "identity": "-",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "artifactName": "AJING-AI-DJ-${version}-${arch}.${ext}"
  }
}
